body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: "Inter";
    font-size: 15dp;
    font-weight: 400;
    color: #eef1f5;
    background-color: transparent;
}

* { box-sizing: border-box; }

.overlay-root, .dashboard-root, .modal-layer, .toast-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.hidden { display: none; }

.card {
    background-color: #0d0f14fa;
    border: 1dp #22263080;
    border-radius: 12dp;
    padding: 8dp 10dp;
    color: #eef1f5;
}

.card.compact { padding: 6dp 8dp; }
.card-title { display: block; font-family: "Russo One"; font-size: 13dp; letter-spacing: 0.5dp; color: #eef1f5; margin-bottom: 5dp; }
.card-subtitle { display: block; color: #8f99a8; font-size: 11dp; font-weight: 500; line-height: 1.2; }
.overlay-widget-title { display: block; color: #8f99a8; font-size: 10dp; font-weight: 700; letter-spacing: 0.3dp; line-height: 1.2; margin-top: 7dp; margin-bottom: 4dp; }
.stat-section-title { display: block; color: #778190; font-size: 10dp; font-weight: 700; letter-spacing: 0.3dp; line-height: 1.2; margin-bottom: 4dp; }

.row { display: flex; flex-direction: row; align-items: center; }
.row.wrap { flex-wrap: wrap; }
.col { display: flex; flex-direction: column; }
.gap-xs { gap: 3dp; }
.gap-sm { gap: 6dp; }
.gap-md { gap: 10dp; }
.gap-lg { gap: 16dp; }
.grow { flex-grow: 1; }
.center { align-items: center; justify-content: center; }
.right { text-align: right; }

.label { color: #9da6b3; font-size: 12dp; font-weight: 500; line-height: 1.25; }
.value { color: #eef1f5; font-weight: 700; line-height: 1.25; }
div.label { display: block; }
div.value { display: block; }
.mono { font-family: "JetBrains Mono"; }
.muted { color: #9da6b3; }
.dim { color: #707987; }
.accent { color: #ff0021; }
.win { color: #43d926; }
.loss { color: #ff3030; }
.blue { color: #4a96ff; }
.orange { color: #ff963e; }

.badge {
    display: inline-block;
    padding: 1dp 5dp;
    border: 1dp #2b303d;
    border-radius: 8dp;
    font-size: 10dp;
    font-weight: 700;
    letter-spacing: 0.2dp;
    color: #9da6b3;
    background-color: #11141bcc;
}
.badge.win { border-color: #43d92688; color: #43d926; }
.badge.loss { border-color: #ff303088; color: #ff3030; }
.badge.blue { border-color: #4a96ff88; color: #4a96ff; }
.badge.orange { border-color: #ff963e88; color: #ff963e; }
.badge.accent { border-color: #ff002188; color: #ff0021; }

.stat-grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: 4dp; align-items: stretch; }
.stat-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 36dp;
    flex-grow: 0;
    padding: 4dp 6dp;
    border: 1dp #252a35;
    border-radius: 5dp;
    background-color: #10131a80;
    text-align: center;
}
.stat-grid.cols-2 .stat-cell { width: 48%; flex-grow: 1; }
.stat-grid.cols-3 .stat-cell { width: 31%; flex-grow: 1; }
.stat-cell .label { display: block; width: 100%; margin-bottom: 2dp; text-align: center; font-size: 10dp; line-height: 1.15; }
.stat-cell .value { display: block; width: 100%; text-align: center; font-size: 12dp; line-height: 1.15; }
.compact-stats .stat-cell { min-height: 34dp; padding: 3dp 5dp; }

.metric-list { display: block; width: 100%; }
.metric-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 26dp;
    padding: 3dp 1dp;
    border-bottom: 1dp #252b3455;
}
.metric-label { flex-grow: 1; min-width: 0; color: #909aa8; font-size: 11dp; font-weight: 500; line-height: 1.15; }
.metric-value { flex-shrink: 0; min-width: 80dp; text-align: right; color: #eef1f5; font-size: 11dp; font-weight: 700; line-height: 1.15; }
.metric-pair { display: flex; flex-direction: row; gap: 5dp; }
.mini-metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    min-width: 0;
    min-height: 36dp;
    padding: 4dp 5dp;
    border: 1dp #252a35;
    border-radius: 5dp;
    background-color: #10131a80;
    text-align: center;
}
.mini-metric .label { font-size: 10dp; margin-bottom: 2dp; }
.mini-metric .value { font-size: 11dp; }
.gamemode-breakdown .row { min-height: 24dp; font-size: 11dp; }
.gamemode-breakdown .value { font-size: 11dp; }
.gamemode-breakdown .label { font-size: 10dp; }

.team-block { margin-top: 6dp; }
.team-header { display: flex; flex-direction: row; align-items: center; margin-bottom: 4dp; }
.team-line { width: 3dp; height: 14dp; margin-right: 7dp; border-radius: 2dp; }
.team-line.blue { background-color: #4a96ff; }
.team-line.orange { background-color: #ff963e; }

/* Roster player card: rank crest, identity with stat chips, status column. */
.player-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 52dp;
    margin-bottom: 5dp;
    padding: 6dp 8dp;
    border: 1dp #242936aa;
    border-radius: 10dp;
    background-color: #10141bb0;
}
.player-row.self { border-color: #3a2731; background-color: #191019c0; }
.player-crest { flex-shrink: 0; display: flex; align-items: center; margin-right: 8dp; }
.player-crest .rank-badge { margin-right: 0; }
.player-identity { display: flex; flex-direction: column; flex-grow: 1; min-width: 0; width: 0; }
.player-headline { display: flex; flex-direction: row; align-items: center; gap: 6dp; min-width: 0; }
.player-name-text {
    min-width: 0;
    font-size: 14dp;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.player-link { cursor: pointer; }
.player-chips { display: flex; flex-direction: row; flex-wrap: wrap; gap: 4dp; margin-top: 4dp; }
.chip {
    display: inline-block;
    padding: 1dp 6dp;
    border: 1dp #2b303d;
    border-radius: 6dp;
    background-color: #171c25cc;
    color: #c3cad6;
    font-size: 10dp;
    font-weight: 600;
    line-height: 1.35;
    white-space: nowrap;
}
.chip.chip-mmr { font-family: "JetBrains Mono"; font-weight: 700; }
.player-flags {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    flex-shrink: 0;
    min-width: 52dp;
    margin-left: 8dp;
    gap: 2dp;
}
.player-flags .label { display: block; font-size: 10dp; line-height: 1.2; text-align: right; }
.player-name {
    flex-grow: 1;
    flex-shrink: 0;
    min-width: 140dp;
    width: 0;
    font-size: 14dp;
    line-height: 1.25;
    padding-right: 6dp;
}
/* Compact lobby table. Fixed playlist columns match the legacy overlay and
   keep the player identity column from collapsing when five or more ranks are
   enabled. */
/* The lobby table reuses .player-row for metrics only: it stays a flat table
   row, not a card. */
.lobby-rank-row { align-items: center; min-height: 28dp; margin: 0; padding: 2dp; border: 0; border-top: 1dp #24293644; border-radius: 0; background-color: transparent; }
.lobby-rank-row .player-name {
    flex-grow: 0;
    flex-shrink: 0;
    width: 135dp;
    min-width: 125dp;
    padding-right: 6dp;
    font-size: 11dp;
    white-space: nowrap;
}
.lobby-rank-row .player-name { overflow: hidden; }
.lobby-rank-row .player-name > .value {
    display: inline;
    white-space: nowrap;
}
/* The platform sits on the name's baseline so each player costs one row. */
.lobby-rank-row .player-name .label {
    display: inline;
    margin-top: 0;
    margin-left: 6dp;
    font-size: 10dp;
    white-space: nowrap;
}
.lobby-rank-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    flex-shrink: 0;
    width: 68dp;
    min-width: 60dp;
    overflow: hidden;
    padding: 0 2dp;
    text-align: center;
    font-size: 9.5dp;
    font-weight: 600;
    line-height: 1.15;
    white-space: nowrap;
}
/* Rank sits directly above the rating, both centred in the column. */
.lobby-rank-value { display: flex; flex-direction: column; align-items: center; width: 100%; }
.lobby-rank-value > div { display: block; width: 100%; text-align: center; white-space: nowrap; }
/* Season games played trails the rating on the same line. */
.lobby-rank-matches {
    display: inline;
    margin-left: 3dp;
    font-family: "Inter";
    font-size: 8dp;
    font-weight: 500;
    color: #6f7887;
}
.lobby-rank-header { min-height: 22dp; font-size: 9dp; font-weight: 700; letter-spacing: 0.3dp; color: #8993a2; }
.lobby-rank-header .player-name { display: flex; align-items: center; }
.rank-icon { width: 30dp; height: 20dp; margin-right: 5dp; }

.lobby-rank-heading { display: block; width: 100%; text-align: center; }
.lobby-rank-header .player-name .lobby-rank-heading { text-align: left; }
.overlay-card { position: absolute; pointer-events: none; min-width: 220dp; }
.overlay-card.interactive { pointer-events: auto; cursor: move; }
.overlay-card.interactive * { cursor: move; }
.overlay-card.interactive button,
.overlay-card.interactive a,
.overlay-card.interactive select,
.overlay-card.interactive input,
.overlay-card.interactive .player-link { cursor: pointer; }
.overlay-card.interactive .overlay-resize { cursor: resize; }
.overlay-edit {
    border: 1dp #ff0021;
    background-color: #0e1018f8;
}
.overlay-drag { cursor: move; }
.overlay-widget-handle { cursor: move; min-height: 24dp; padding: 2dp 0; }
.widget-close { min-width: 24dp; width: 24dp; min-height: 22dp; height: 22dp; padding: 0; margin-left: 6dp; background-color: #35171a; border-color: #743238; color: #ffb2b7; }
.overlay-resize { position: absolute; width: 13dp; height: 13dp; right: 2dp; bottom: 2dp; cursor: resize; background-color: #ff002166; }
.overlay-snap-guide { position: absolute; display: none; pointer-events: none; background-color: #eb8c24cc; }
.overlay-snap-guide.vertical { top: 0; width: 2dp; height: 100%; }
.overlay-snap-guide.horizontal { left: 0; width: 100%; height: 2dp; }
.overlay-toolbox-toggle {
    position: absolute;
    left: 12dp;
    top: 12dp;
    min-width: 86dp;
    min-height: 32dp;
    padding: 4dp 12dp;
    pointer-events: auto;
    font-size: 13dp;
    font-weight: 600;
    text-align: center;
    background-color: #263644e6;
    border-color: #34485a;
}
.overlay-toolbox {
    position: absolute;
    left: 12dp;
    top: 54dp;
    width: 280dp;
    max-height: 80%;
    overflow-y: auto;
    pointer-events: auto;
}
.overlay-toolbox .col > .row {
    min-height: 32dp;
    padding: 4dp 2dp;
    border-top: 1dp #23283355;
}
.overlay-toolbox .col > .row:first-child { border-top: 0; }

.running-indicator {
    position: absolute;
    left: 14dp;
    bottom: 12dp;
    padding: 4dp 7dp;
    font-size: 11dp;
    color: #9da6b3;
    background-color: #0d0f14cc;
    border: 1dp #2b303d;
    border-radius: 7dp;
}

.match-summary {
    position: absolute;
    left: 50%;
    top: 14%;
    width: 420dp;
    margin-left: -210dp;
    pointer-events: auto;
}
/* Draggable only while the overlay accepts input; otherwise the card must not
   claim the cursor away from the game. */
.floating-card-movable { cursor: move; }
.floating-card-movable * { cursor: move; }
.floating-card-movable button, .floating-card-movable .player-link { cursor: pointer; }
.summary-score { font-family: "Russo One"; font-size: 34dp; text-align: center; margin: 8dp 0; }

.dashboard-shell {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #0a0c10;
    border-radius: 10dp;
    border: 1dp #232a36;
    overflow: hidden;
    pointer-events: auto;
}
.dashboard-shell.maximized {
    border-radius: 0;
    border: 0;
}
.dashboard-topbar {
    height: 34dp;
    padding: 3dp 10dp;
    background-color: #10131a;
    border-bottom: 1dp #2b303d;
    display: flex;
    flex-direction: row;
    align-items: center;
}
.brand-logo { width: 22dp; height: 22dp; margin-right: 7dp; }
.brand-title { display: flex; flex-direction: row; align-items: baseline; font-family: "Russo One"; font-size: 14dp; letter-spacing: 0.4dp; line-height: 1; }
.brand-title .version { font-family: "Inter"; font-size: 9dp; font-weight: 600; letter-spacing: 0; color: #9da6b3; margin-left: 5dp; }
.dashboard-topbar .match-status { font-size: 11dp; font-weight: 500; color: #8f99a8; margin-left: 14dp; }
.playlist-icon { width: 20dp; height: 20dp; }
.roster-header { display: block; padding-bottom: 4dp; border-bottom: 1dp #252a3555; }
.roster-footer { display: flex; flex-direction: row; justify-content: space-between; gap: 7dp; margin-top: 4dp; padding-top: 4dp; border-top: 1dp #252a3555; color: #8f99a8; font-size: 10dp; }
.dashboard-widget-title { display: flex; flex-direction: row; align-items: center; margin-bottom: 5dp; }
.dashboard-widget-title .name { font-family: "Russo One"; font-size: 13dp; letter-spacing: 0.4dp; }
.dashboard-content { display: block; width: 100%; padding: 6dp 8dp; box-sizing: border-box; }
.dashboard-zone-top { display: block; width: 100%; margin-bottom: 6dp; box-sizing: border-box; }
.dashboard-columns { display: flex; flex-direction: row; width: 100%; gap: 8dp; align-items: flex-start; box-sizing: border-box; }
.dashboard-column { display: flex; flex-direction: column; flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; box-sizing: border-box; }
.dashboard-zone-left, .dashboard-zone-right, .dashboard-zone-bottom { display: block; width: 100%; box-sizing: border-box; }
.dashboard-widget {
    display: block;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 6dp;
    border: 0;
    background-color: transparent;
    pointer-events: auto;
}
.dashboard-edit-active .dashboard-widget {
    border: 1dp solid #272e3a;
    border-radius: 6dp;
    padding: 4dp 6dp;
}
.dashboard-widget.dragging {
    opacity: 0.65;
    border: 1dp solid #ff0021;
}
.dashboard-widget.drag-target {
    border: 1dp solid #ff0021;
}
.dashboard-drop-slot {
    display: none;
    height: 16dp;
    margin: 3dp 0;
    border: 1dp dashed #3b4657;
    border-radius: 4dp;
    background-color: #14182240;
    text-align: center;
    align-items: center;
    justify-content: center;
}
.dashboard-edit-active .dashboard-drop-slot {
    display: flex;
}
.dashboard-drop-slot .drop-hint {
    font-size: 9dp;
    color: #5c6878;
    pointer-events: none;
}
.dashboard-drop-slot.drag-target {
    border: 2dp solid #ff0021;
    background-color: #ff002125;
}
.dashboard-drop-slot.drag-target .drop-hint {
    color: #ff8088;
    font-weight: 700;
}
.dashboard-widget.dragging {
    opacity: 0.45;
    border: 2dp dashed #ff0021;
}
.dashboard-widget.drag-target {
    border: 2dp solid #ff0021;
}
.dashboard-widget .player-row {
    min-height: 38dp;
    margin-bottom: 3dp;
    padding: 3dp 6dp;
    border-radius: 6dp;
}
.dashboard-widget .player-name-text { font-size: 12dp; }
.dashboard-widget .player-flags .label { font-size: 9dp; }
.dashboard-widget .chip { font-size: 9dp; padding: 1dp 5dp; }
.dashboard-widget .stat-cell { min-height: 28dp; padding: 2dp 4dp; }
.dashboard-widget .compact-stats .stat-cell { min-height: 25dp; padding: 2dp 4dp; }
.dashboard-widget .metric-row { min-height: 21dp; padding: 1dp 1dp; }
.dashboard-widget .metric-label { font-size: 10dp; }
.dashboard-widget .metric-value { font-size: 10dp; }
.dashboard-widget .graph-wrap { height: 160dp; }
.dashboard-widget .match-row { min-height: 22dp; padding: 1dp 2dp; font-size: 11dp; }
.dashboard-widget .match-header { min-height: 20dp; font-size: 10dp; }
.dashboard-widget .previous-games-footer { min-height: 22dp; margin-top: 4dp; padding: 3dp 2dp 0 2dp; font-size: 11dp; }
.previous-games-list { display: block; width: 100%; }
.dashboard-widget .previous-games-list { display: block; width: 100%; }
.lobby-rank-table { display: block; width: 100%; }
/* Only the fixed-column rank table may scroll sideways; the widget itself must
   not become a scroll container or its flex children collapse to zero width. */
.dashboard-widget .lobby-rank-table { overflow-x: auto; }
.dashboard-hidden { padding: 8dp; border-top: 1dp #2b303d; }
.dashboard-modal { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background-color: #00000070; pointer-events: auto; }
.update-dialog { width: 470dp; max-width: 92%; background-color: #151820f5; }

button, .button {
    min-height: 27dp;
    padding: 4dp 9dp;
    background-color: #202530;
    border: 1dp #323947;
    border-radius: 5dp;
    color: #eef1f5;
    cursor: pointer;
    text-align: center;
}
button:hover, .button:hover { background-color: #2a303d; border-color: #485164; }
button:active, .button:active { background-color: #181c24; }
button.primary, .button.primary { background-color: #c9001b; border-color: #ef1734; }
button.danger, .button.danger { background-color: #35171a; border-color: #743238; color: #ff8e95; }
button.ghost, .button.ghost { background-color: transparent; }
button.compact {
    min-height: 22dp;
    height: 22dp;
    line-height: 20dp;
    padding: 0 8dp;
    font-size: 11dp;
    text-align: center;
    vertical-align: middle;
}
button.window-control {
    width: 26dp;
    min-width: 26dp;
    height: 22dp;
    min-height: 22dp;
    line-height: 20dp;
    padding: 0;
    margin-left: 2dp;
    border: 1dp transparent;
    border-radius: 4dp;
    background-color: transparent;
    font-size: 12dp;
    font-family: "JetBrains Mono";
    font-weight: 700;
    color: #c8d0dc;
    text-align: center;
    vertical-align: middle;
}
button.window-control:hover {
    background-color: #232a36;
    border-color: #353f4e;
}
button.window-control.danger:hover {
    background-color: #e81123;
    border-color: #e81123;
    color: #ffffff;
}
.topbar-actions {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-left: auto;
}
.win-icon-min {
    display: inline-block;
    width: 9dp;
    height: 1dp;
    background-color: #c8d0dc;
    vertical-align: middle;
    margin-bottom: 2dp;
}
.win-icon-max {
    display: inline-block;
    width: 8dp;
    height: 8dp;
    border: 1dp #c8d0dc;
    border-radius: 1dp;
    vertical-align: middle;
}
.win-icon-restore {
    display: inline-block;
    position: relative;
    width: 10dp;
    height: 10dp;
    vertical-align: middle;
}
.win-icon-restore .restore-back {
    position: absolute;
    right: 0;
    top: 0;
    width: 7dp;
    height: 7dp;
    border-top: 1dp #c8d0dc;
    border-right: 1dp #c8d0dc;
    border-radius: 1dp;
}
.win-icon-restore .restore-front {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 7dp;
    height: 7dp;
    border: 1dp #c8d0dc;
    border-radius: 1dp;
    background-color: #10131a;
}
.win-icon-close {
    display: inline-block;
    font-family: "Arial", "Inter", sans-serif;
    font-size: 15dp;
    line-height: 14dp;
    color: #c8d0dc;
    vertical-align: middle;
}
button.window-control:hover .win-icon-min,
button.window-control:hover .win-icon-max,
button.window-control:hover .win-icon-restore .restore-back,
button.window-control:hover .win-icon-restore .restore-front {
    border-color: #ffffff;
}
button.window-control.danger:hover .win-icon-close {
    color: #ffffff;
}
.widget-controls { margin-bottom: 7dp; }
.compact-select { min-width: 122dp; height: 26dp; font-size: 12dp; }
button:disabled { color: #606978; background-color: #161920; border-color: #242936; cursor: unavailable; }

.modal-layer { pointer-events: none; }
.modal-backdrop { display: none; }
.confirm-backdrop {
    position: absolute;
    left: 0; top: 0; width: 100%; height: 100%;
    background-color: #00000088;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    z-index: 100;
}
.settings-window {
    position: absolute;
    display: flex;
    flex-direction: column;
    width: 900dp;
    max-width: 94%;
    height: 650dp;
    max-height: 92%;
    background-color: #0c0f14fa;
    border: 1dp #2a313d;
    border-radius: 12dp;
    overflow: hidden;
    pointer-events: auto;
}
.settings-header {
    height: 58dp;
    min-height: 58dp;
    flex-shrink: 0;
    padding: 11dp 16dp;
    background-color: #11151c;
    border-bottom: 1dp #272d38;
    cursor: move;
}
.settings-header button { cursor: pointer; }
.settings-header > .grow { display: flex; flex-direction: column; justify-content: center; }
.settings-header .brand-title { font-size: 17dp; }
.settings-header .label { font-size: 12dp; margin-top: 2dp; }
.settings-body { display: flex; flex-direction: row; flex-grow: 1; height: 0; min-height: 0; }
.settings-nav {
    width: 152dp;
    min-width: 152dp;
    padding: 11dp 8dp;
    background-color: #0e1117;
    border-right: 1dp #252b35;
    flex-shrink: 0;
    overflow-y: auto;
}
.settings-nav button {
    display: block;
    width: 100%;
    min-height: 32dp;
    padding: 6dp 9dp;
    text-align: left;
    margin: 0 0 3dp 0;
    border-color: transparent;
    border-radius: 5dp;
    background-color: transparent;
    color: #939dab;
    font-size: 14dp;
    font-weight: 600;
    line-height: 1.25;
}
.settings-nav button:hover { color: #eef1f5; background-color: #171c24; border-color: #242b37; }
.settings-nav button.active { border-color: #5d1a25; color: #ffffff; background-color: #251218; }
.settings-page {
    flex-grow: 1;
    min-width: 0;
    height: 100%;
    padding: 12dp 14dp 18dp 14dp;
    overflow-y: auto;
    background-color: #0a0d12;
}
.settings-footer {
    height: 48dp;
    min-height: 48dp;
    flex-shrink: 0;
    padding: 8dp 13dp;
    border-top: 1dp #272d38;
    background-color: #10141a;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    gap: 7dp;
}
.setting-section {
    display: block;
    margin-bottom: 14dp;
    padding: 2dp 0 6dp 0;
    border-bottom: 1dp #262c3555;
}
.setting-title {
    display: block;
    font-weight: 700;
    font-size: 14dp;
    letter-spacing: 0.3dp;
    color: #ff1838;
    margin-bottom: 6dp;
    line-height: 1.2;
}
.setting-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 36dp;
    padding: 4dp 0;
    border-top: 1dp #20253044;
}
.setting-info { display: flex; flex-direction: column; justify-content: center; flex-grow: 1; min-width: 0; padding-right: 16dp; }
.setting-name { display: block; color: #edf1f6; font-size: 12dp; font-weight: 600; line-height: 1.25; }
.setting-help { display: block; color: #747e8c; font-size: 10.5dp; line-height: 1.35; margin-top: 2dp; }
.settings-page select { min-width: 155dp; max-width: 270dp; font-size: 11.5dp; height: 26dp; }
.settings-page input.text, .settings-page input.password { min-width: 190dp; max-width: 320dp; font-size: 11.5dp; height: 26dp; }
.settings-page button, .settings-page .button { font-size: 11.5dp; }
.setting-row > input, .setting-row > select, .setting-row > button, .setting-row > .row { flex-shrink: 0; }
.rank-table { margin-top: 7dp; border: 1dp #2c3240; border-radius: 5dp; overflow: hidden; }
.rank-table-row { display: flex; flex-direction: row; min-height: 26dp; align-items: center; border-top: 1dp #252a3555; }
.rank-table-row:first-child { border-top: 0; }
.rank-table-row.header { background-color: #10131a; color: #9da6b3; font-size: 10dp; font-weight: 700; }
.rank-table-row > div { flex-grow: 1; width: 25%; padding: 3dp 6dp; font-size: 11dp; }

input.text, input.password, select {
    height: 28dp;
    padding: 4dp 7dp;
    background-color: #0f1218;
    border: 1dp #343b49;
    border-radius: 4dp;
    color: #eef1f5;
}
input.text:focus, input.password:focus, select:focus, select:checked { border-color: #ff0021; }

.toggle-switch {
    position: relative;
    display: block;
    width: 42dp;
    min-width: 42dp;
    height: 22dp;
    margin-left: 10dp;
}
input.checkbox {
    width: 42dp;
    min-width: 42dp;
    height: 22dp;
    border: 1dp #454c5a;
    border-radius: 11dp;
    background-color: #252a34;
    cursor: pointer;
}
.toggle-thumb {
    position: absolute;
    left: 4dp;
    top: 5dp;
    width: 12dp;
    height: 12dp;
    border-radius: 6dp;
    background-color: #9aa4b2;
    pointer-events: none;
    transition: left 0.14s cubic-in-out, background-color 0.14s linear;
}
input.checkbox:hover { border-color: #626c7e; background-color: #2f3541; }
input.checkbox:checked { border-color: #ff2340; background-color: #b5001a; }
input.checkbox:checked ~ .toggle-thumb { left: 26dp; background-color: #ffffff; }
input.checkbox:disabled { border-color: #303642; background-color: #1b1f27; cursor: unavailable; opacity: 0.55; }
input.checkbox:disabled ~ .toggle-thumb { background-color: #4d5564; }

input.range {
    width: 180dp;
    height: 20dp;
    padding: 0;
    background-color: transparent;
    border: 0;
}
input.range sliderarrowdec, input.range sliderarrowinc { width: 0; height: 0; }
input.range slidertrack {
    height: 4dp;
    margin-top: 8dp;
    border-radius: 2dp;
    background-color: #2d3441;
}
input.range sliderprogress {
    height: 4dp;
    border-radius: 2dp;
    background-color: #a90017;
}
input.range sliderbar {
    width: 14dp;
    height: 14dp;
    margin-top: -5dp;
    border: 2dp #ff0021;
    border-radius: 7dp;
    background-color: #eef1f5;
    cursor: move;
}
input.range sliderbar:hover, input.range sliderbar:active { background-color: #ffffff; }

select { padding: 0; position: relative; }
select selectvalue {
    width: 100%;
    height: 26dp;
    padding: 4dp 28dp 4dp 7dp;
    color: #eef1f5;
    background-color: #0f1218;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
select selectarrow {
    position: absolute;
    right: 1dp;
    top: 1dp;
    width: 24dp;
    height: 24dp;
    border-left: 1dp #343b49;
    background-color: #181d26;
    cursor: pointer;
    decorator: image(res://images/chevron.png);
}
select selectarrow:hover, select:checked selectarrow { background-color: #252c38; }
select selectbox {
    margin-top: 2dp;
    min-width: 100%;
    max-height: 250dp;
    overflow-y: auto;
    padding: 3dp;
    border: 1dp #343b49;
    border-radius: 4dp;
    background-color: #11151c;
}
select selectbox option {
    min-height: 25dp;
    padding: 5dp 7dp;
    border-radius: 3dp;
    color: #dce1e8;
    background-color: transparent;
}
select selectbox option:hover { background-color: #252c38; }
select selectbox option:checked { background-color: #35131a; color: #ffffff; }

scrollbarvertical {
    width: 9dp;
    margin-left: 2dp;
    background-color: #0b0e13aa;
}
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0; height: 0; }
scrollbarvertical slidertrack { width: 7dp; margin-left: 1dp; background-color: transparent; }
scrollbarvertical sliderbar {
    width: 7dp;
    min-height: 28dp;
    border-radius: 4dp;
    background-color: #3b4352cc;
}
scrollbarvertical sliderbar:hover { background-color: #596376dd; }
scrollbarvertical sliderbar:active { background-color: #ff0021cc; }
.graph-header { min-height: 28dp; margin-bottom: 6dp; }
.graph-zoom { display: flex; flex-direction: row; gap: 3dp; margin-right: 5dp; }
.graph-zoom .zoom-step { min-width: 24dp; padding-left: 6dp; padding-right: 6dp; font-family: "JetBrains Mono"; }

scrollbarhorizontal {
    height: 9dp;
    margin-top: 2dp;
    background-color: #0b0e13aa;
}
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc { width: 0; height: 0; }
scrollbarhorizontal slidertrack { height: 7dp; margin-top: 1dp; background-color: transparent; }
scrollbarhorizontal sliderbar {
    height: 7dp;
    min-width: 28dp;
    border-radius: 4dp;
    background-color: #3b4352cc;
}
scrollbarhorizontal sliderbar:hover { background-color: #596376dd; }
scrollbarhorizontal sliderbar:active { background-color: #ff0021cc; }
scrollbarcorner { background-color: #0b0e13aa; }

.color-dot { width: 20dp; height: 20dp; border: 1dp #ffffff33; border-radius: 4dp; }
.color-dot-button { min-width: 20dp; padding: 0; margin: 0; }
.color-dot-button.active { border: 2dp #ffffff; }
.color-row-active { border-top: 1dp #ff183888; }
.color-editor-panel {
    display: block;
    margin: 4dp 0 10dp 0;
    padding: 8dp 10dp;
    background-color: #12151c;
    border: 1dp #2a3140;
    border-radius: 8dp;
}
/* Saturation/value field plus hue strip. RmlUi paints CSS gradients through
   render-interface shaders that this D3D11 interface does not implement, so both
   use procedurally generated `gen://` textures instead. */
.color-picker { display: block; margin: 6dp 0 10dp 0; }
.color-field {
    position: relative;
    display: block;
    width: 100%;
    height: 120dp;
    border: 1dp #ffffff33;
    border-radius: 5dp;
    cursor: cross;
}
.color-field-marker {
    position: absolute;
    width: 12dp;
    height: 12dp;
    margin-left: -6dp;
    margin-top: -6dp;
    border: 2dp #ffffff;
    border-radius: 7dp;
    pointer-events: none;
}
.color-hue {
    position: relative;
    display: block;
    width: 100%;
    height: 16dp;
    margin-top: 8dp;
    border: 1dp #ffffff33;
    border-radius: 5dp;
    cursor: cross;
    decorator: image(gen://hue);
}
.color-hue-marker {
    position: absolute;
    top: -2dp;
    width: 6dp;
    height: 18dp;
    margin-left: -3dp;
    border: 2dp #ffffff;
    border-radius: 3dp;
    pointer-events: none;
}
.color-editor-preview { width: 100%; height: 28dp; border: 1dp #ffffff33; border-radius: 5dp; margin: 4dp 0 8dp 0; }
.color-channel { display: flex; flex-direction: row; align-items: center; min-height: 27dp; gap: 8dp; }
.color-channel-label { width: 14dp; font-family: "JetBrains Mono"; font-size: 11dp; color: #9da6b3; }
.color-range { flex-grow: 1; width: auto; }
.color-channel-value { width: 30dp; text-align: right; color: #9da6b3; }

.graph-wrap { position: relative; height: 220dp; background-color: #0d1016; border: 1dp #242a35; border-radius: 6dp; overflow: hidden; }
.graph-empty { min-height: 150dp; display: flex; flex-direction: column; justify-content: center; gap: 4dp; padding: 0 8dp; }
.graph-gridline { position: absolute; height: 1dp; background-color: #69728055; }
.graph-label { position: absolute; color: #697280; font-family: "JetBrains Mono"; font-size: 10dp; }
.graph-last { text-align: right; }
.graph-polyline { display: block; position: absolute; left: 0; top: 0; width: 100%; height: 100%; color: #5480d8; pointer-events: none; }
.graph-line { position: absolute; height: 2dp; background-color: #5480d8; transform-origin: left center; opacity: 0.88; }
.graph-line.baseline { height: 1dp; background-color: #e8f300; opacity: 0.48; }
.graph-point { position: absolute; width: 8dp; height: 8dp; margin-left: -4dp; margin-top: -4dp; border-radius: 5dp; background-color: #5480d8; }
.graph-point.win { background-color: #43d926; }
.graph-point.loss { background-color: #ff3030; }
.graph-point.neutral { background-color: #9da6b3; }
.graph-point.current { width: 12dp; height: 12dp; margin-left: -6dp; margin-top: -6dp; border-radius: 7dp; }
.graph-point.estimated { background-color: transparent; border: 2dp #eef1f5; }
.graph-point-halo { position: absolute; width: 20dp; height: 20dp; margin-left: -10dp; margin-top: -10dp; border-radius: 11dp; background-color: #5480d8; opacity: 0.20; }
.graph-point-halo.win { background-color: #43d926; }
.graph-point-halo.loss { background-color: #ff3030; }
.graph-point-halo.neutral { background-color: #9da6b3; }
.graph-current { position: absolute; font-family: "JetBrains Mono"; font-size: 13dp; font-weight: 700; white-space: nowrap; }

.previous-games-header { min-height: 27dp; margin-bottom: 3dp; }
.previous-games-header .card-title { margin-bottom: 0; }
.match-row { display: flex; flex-direction: row; align-items: center; min-height: 26dp; padding: 1dp 2dp; font-size: 12dp; font-weight: 600; border-top: 1dp #252a3555; }
.match-header { min-height: 24dp; color: #707987; font-size: 11dp; font-weight: 700; letter-spacing: 0.3dp; }
.match-header .match-mode, .match-header .match-score, .match-header .match-mmr, .match-header .match-time { color: #707987; font-family: "Inter"; }
.match-mode { width: 28%; flex: 0 0 28%; color: #9da6b3; padding-left: 6dp; text-align: left; }
.match-score { width: 24%; flex: 0 0 24%; text-align: center; font-family: "JetBrains Mono"; }
.match-mmr { width: 24%; flex: 0 0 24%; text-align: center; font-family: "JetBrains Mono"; }
.match-time { width: 24%; flex: 0 0 24%; text-align: right; padding-right: 6dp; color: #707987; font-size: 11dp; }
.match-data { min-height: 29dp; border-top: 0; }
.match-data.match-even { background-color: #11151a99; }
.match-data.match-odd { background-color: #090c1099; }
.match-data:hover { background-color: #1a2028cc; }
.match-win { color: #2ecc71; }
.match-loss { color: #e74c3c; }
/* The result color owns the entire row, including the playlist and time columns
   that otherwise carry their own muted colors. */
.match-win .match-mode, .match-win .match-time { color: #2ecc71; }
.match-loss .match-mode, .match-loss .match-time { color: #e74c3c; }
.previous-games-footer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 30dp;
    margin-top: 8dp;
    padding: 7dp 2dp 1dp 2dp;
    border-top: 1dp #2a303a;
    color: #9da6b3;
    font-size: 12dp;
    font-family: "Inter";
}

.toast-root { pointer-events: none; }
.toast { position: absolute; right: 14dp; bottom: 14dp; width: 330dp; background-color: #141820f5; border: 1dp #323a49; border-radius: 7dp; padding: 9dp 11dp; }
.toast.error { border-color: #7d3037; }
.toast.success { border-color: #397d30; }

@media (max-width: 850dp) {
    .settings-window { width: 96%; height: 94%; }
    .settings-nav { width: 145dp; }
    .dashboard-columns { flex-direction: column; }
    .dashboard-column { width: 100%; }
}

/* Platform identity. Colors are applied by the theme pass from
   kPlatformPalette so they survive `.badge`/`.label` theming. */
.platform { font-weight: 700; }
.badge.platform { border-color: #ffffff33; }

/* Native rank badge parity: tier crest + four-step Rocket League division stack. */
.rank-badge { display: flex; flex-direction: row; align-items: center; flex-shrink: 0; margin-right: 8dp; min-width: 45dp; }
.rank-badge .rank-icon { margin-right: 3dp; }
.division-stack { width: 11dp; display: flex; flex-direction: column; justify-content: center; gap: 1dp; }
.division-pill { width: 11dp; height: 3dp; }
.tooltip-host { position: relative; }
.tooltip-bubble {
    display: none;
    position: absolute;
    z-index: 200;
    left: 50%;
    bottom: 100%;
    width: auto;
    min-width: 120dp;
    max-width: 260dp;
    margin-left: -60dp;
    margin-bottom: 5dp;
    padding: 5dp 7dp;
    background-color: #07090df2;
    border: 1dp #3a4252;
    border-radius: 4dp;
    color: #eef1f5;
    font-size: 11dp;
    font-family: "Inter";
    white-space: nowrap;
    pointer-events: none;
}
.tooltip-host:hover .tooltip-bubble { display: block; }

.controller-debug { margin-top: 10dp; padding-top: 8dp; border-top: 1dp #2b303d; }
.debug-grid { display: flex; flex-direction: column; margin-top: 5dp; font-size: 11dp; }
.debug-row { display: flex; flex-direction: row; margin-top: 3dp; }
.debug-label { width: 135dp; color: #9da6b3; }
.debug-value { flex-grow: 1; color: #eef1f5; font-family: "JetBrains Mono"; }
.privacy-dialog { width: 520dp; max-width: 92%; }
