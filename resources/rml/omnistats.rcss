body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: "Segoe UI";
    font-size: 14dp;
    color: #eef1f5;
    background-color: transparent;
}

* { box-sizing: border-box; }

.overlay-root, .dashboard-root, .modal-layer, .toast-root {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

.hidden { display: none; }

.card {
    background-color: #0d0f14ed;
    border: 1dp #2b303d;
    border-radius: 8dp;
    padding: 8dp 10dp;
    color: #eef1f5;
}

.card.compact { padding: 6dp 8dp; }
.card-title { display: block; font-weight: 700; font-size: 12dp; color: #eef1f5; margin-bottom: 5dp; }
.card-subtitle { display: block; color: #8f99a8; font-size: 10dp; line-height: 1.2; }
.overlay-widget-title { display: block; color: #8f99a8; font-size: 9dp; font-weight: 700; line-height: 1.2; margin-top: 7dp; margin-bottom: 4dp; }
.stat-section-title { display: block; color: #778190; font-size: 9dp; font-weight: 700; line-height: 1.2; margin-bottom: 4dp; }

.row { display: flex; flex-direction: row; align-items: center; }
.row.wrap { flex-wrap: wrap; }
.col { display: flex; flex-direction: column; }
.gap-xs { gap: 3dp; }
.gap-sm { gap: 6dp; }
.gap-md { gap: 10dp; }
.gap-lg { gap: 16dp; }
.grow { flex-grow: 1; }
.center { align-items: center; justify-content: center; }
.right { text-align: right; }

.label { color: #9da6b3; font-size: 11dp; line-height: 1.25; }
.value { color: #eef1f5; font-weight: 600; line-height: 1.25; }
div.label { display: block; }
div.value { display: block; }
.mono { font-family: "Consolas"; }
.muted { color: #9da6b3; }
.dim { color: #707987; }
.accent { color: #ff0021; }
.win { color: #43d926; }
.loss { color: #ff3030; }
.blue { color: #4a96ff; }
.orange { color: #ff963e; }

.badge {
    display: inline-block;
    padding: 1dp 5dp;
    border: 1dp #2b303d;
    border-radius: 8dp;
    font-size: 9dp;
    color: #9da6b3;
    background-color: #11141bcc;
}
.badge.win { border-color: #43d92688; color: #43d926; }
.badge.loss { border-color: #ff303088; color: #ff3030; }
.badge.blue { border-color: #4a96ff88; color: #4a96ff; }
.badge.orange { border-color: #ff963e88; color: #ff963e; }
.badge.accent { border-color: #ff002188; color: #ff0021; }

.stat-grid { display: flex; flex-direction: row; flex-wrap: wrap; gap: 4dp; align-items: stretch; }
.stat-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 36dp;
    flex-grow: 0;
    padding: 4dp 6dp;
    border: 1dp #252a35;
    border-radius: 5dp;
    background-color: #10131a80;
    text-align: center;
}
.stat-grid.cols-2 .stat-cell { width: 48%; flex-grow: 1; }
.stat-grid.cols-3 .stat-cell { width: 31%; flex-grow: 1; }
.stat-cell .label { display: block; width: 100%; margin-bottom: 2dp; text-align: center; font-size: 9dp; line-height: 1.15; }
.stat-cell .value { display: block; width: 100%; text-align: center; font-size: 11dp; line-height: 1.15; }
.compact-stats .stat-cell { min-height: 34dp; padding: 3dp 5dp; }

.metric-list { display: block; width: 100%; }
.metric-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 24dp;
    padding: 3dp 1dp;
    border-bottom: 1dp #252b3455;
}
.metric-label { flex-grow: 1; min-width: 0; color: #909aa8; font-size: 10dp; line-height: 1.15; }
.metric-value { flex-shrink: 0; min-width: 74dp; text-align: right; color: #eef1f5; font-size: 10dp; font-weight: 600; line-height: 1.15; }
.metric-pair { display: flex; flex-direction: row; gap: 5dp; }
.mini-metric {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    min-width: 0;
    min-height: 36dp;
    padding: 4dp 5dp;
    border: 1dp #252a35;
    border-radius: 5dp;
    background-color: #10131a80;
    text-align: center;
}
.mini-metric .label { font-size: 9dp; margin-bottom: 2dp; }
.mini-metric .value { font-size: 10dp; }
.gamemode-breakdown .row { min-height: 22dp; font-size: 10dp; }
.gamemode-breakdown .value { font-size: 10dp; }
.gamemode-breakdown .label { font-size: 9dp; }

.team-block { margin-top: 6dp; }
.team-header { display: flex; flex-direction: row; align-items: center; margin-bottom: 4dp; }
.team-line { width: 3dp; height: 14dp; margin-right: 7dp; border-radius: 2dp; }
.team-line.blue { background-color: #4a96ff; }
.team-line.orange { background-color: #ff963e; }

.player-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 38dp;
    margin-top: 3dp;
    padding: 5dp 7dp;
    border: 1dp #24293688;
    border-radius: 5dp;
    background-color: #0b0e13a8;
}
.player-row.self { background-color: #141923cc; border-color: #343b49; }
.player-name {
    flex-grow: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 11dp;
    line-height: 1.2;
    padding-right: 6dp;
}
.player-name > .value { display: inline-block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; vertical-align: middle; }
.player-name .label { display: block; margin-top: 3dp; font-size: 9dp; line-height: 1.15; }
.player-link { cursor: pointer; }
.player-rank { width: 84dp; flex-shrink: 0; text-align: right; font-size: 10dp; line-height: 1.1; }
.player-rank.icon-mode { width: 62dp; color: #707987; }
.player-rank.icon-mode .rank-matches { text-align: right; }
.player-mmr { width: 48dp; flex-shrink: 0; text-align: right; font-family: "Consolas"; font-size: 11dp; font-weight: 700; }

/* Compact lobby table. Fixed playlist columns match the legacy overlay and
   keep the player identity column from collapsing when five or more ranks are
   enabled. */
.lobby-rank-row { align-items: center; min-height: 42dp; margin-top: 0; padding-top: 5dp; padding-bottom: 5dp; border-left: 0; border-right: 0; border-bottom: 0; border-radius: 0; background-color: transparent; }
.lobby-rank-row .player-name {
    flex-grow: 0;
    flex-shrink: 0;
    width: 176dp;
    min-width: 176dp;
    padding-right: 10dp;
    overflow: hidden;
    white-space: normal;
}
.lobby-rank-row .player-name > .value {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.lobby-rank-row .player-name .label {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.lobby-rank-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    flex-shrink: 0;
    width: 70dp;
    min-width: 70dp;
    padding: 0 5dp;
    text-align: center;
    font-size: 9dp;
    line-height: 1.2;
    white-space: nowrap;
}
.lobby-rank-cell > div { display: block; width: 100%; text-align: center; white-space: nowrap; }
.lobby-rank-cell > div:first-child { margin-bottom: 3dp; }
.lobby-rank-header { min-height: 28dp; font-size: 9dp; font-weight: 700; color: #8993a2; }
.lobby-rank-header .player-name { display: flex; align-items: center; }
.rank-icon { width: 30dp; height: 20dp; margin-right: 5dp; }

.overlay-card { position: absolute; pointer-events: none; min-width: 220dp; }
.overlay-card.interactive { pointer-events: auto; }
.overlay-edit {
    border: 1dp #ff0021;
    background-color: #0e1018f8;
}
.overlay-drag { cursor: move; }
.overlay-widget-handle { cursor: move; min-height: 24dp; padding: 2dp 0; }
.widget-close { min-width: 24dp; width: 24dp; min-height: 22dp; height: 22dp; padding: 0; margin-left: 6dp; background-color: #35171a; border-color: #743238; color: #ffb2b7; }
.overlay-resize { position: absolute; width: 13dp; height: 13dp; right: 2dp; bottom: 2dp; cursor: resize; background-color: #ff002166; }
.overlay-snap-guide { position: absolute; display: none; pointer-events: none; background-color: #eb8c24cc; }
.overlay-snap-guide.vertical { top: 0; width: 2dp; height: 100%; }
.overlay-snap-guide.horizontal { left: 0; width: 100%; height: 2dp; }
.overlay-toolbox-toggle {
    position: absolute;
    left: 12dp;
    top: 12dp;
    width: 36dp;
    height: 36dp;
    padding: 0;
    pointer-events: auto;
    font-size: 18dp;
    text-align: center;
    background-color: #263644e6;
    border-color: #34485a;
}
.overlay-toolbox {
    position: absolute;
    left: 12dp;
    top: 54dp;
    width: 260dp;
    max-height: 80%;
    overflow-y: auto;
    pointer-events: auto;
}

.running-indicator {
    position: absolute;
    left: 14dp;
    bottom: 12dp;
    padding: 4dp 7dp;
    font-size: 10dp;
    color: #9da6b3;
    background-color: #0d0f14cc;
    border: 1dp #2b303d;
    border-radius: 5dp;
}

.match-summary {
    position: absolute;
    left: 50%;
    top: 14%;
    width: 420dp;
    margin-left: -210dp;
    pointer-events: auto;
}
.summary-score { font-size: 32dp; font-weight: 800; text-align: center; margin: 8dp 0; }

.dashboard-shell {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: #0a0c10;
    pointer-events: auto;
    overflow: auto;
}
.dashboard-topbar {
    height: 54dp;
    padding: 9dp 14dp;
    background-color: #10131a;
    border-bottom: 1dp #2b303d;
    display: flex;
    flex-direction: row;
    align-items: center;
}
.brand-logo { width: 30dp; height: 30dp; margin-right: 9dp; }
.brand-title { display: block; font-size: 18dp; font-weight: 800; line-height: 1.2; }
.brand-title .version { font-size: 10dp; font-weight: 600; color: #9da6b3; }
.brand-mini { display: block; font-size: 13dp; font-weight: 800; letter-spacing: 1dp; }
.playlist-icon { width: 22dp; height: 22dp; }
.roster-header { display: block; padding-bottom: 6dp; border-bottom: 1dp #252a3555; }
.roster-footer { display: flex; flex-direction: row; justify-content: space-between; gap: 7dp; margin-top: 6dp; padding-top: 5dp; border-top: 1dp #252a3555; color: #8f99a8; font-size: 8dp; }
.rank-matches { display: block; color: #707987; font-size: 8dp; margin-top: 1dp; }
.rank-source-icon { width: 10dp; height: 10dp; margin-right: 3dp; vertical-align: middle; }
.dashboard-content { padding: 12dp; }
.dashboard-zone-top { width: 100%; margin-bottom: 10dp; }
.dashboard-columns { display: flex; flex-direction: row; gap: 10dp; align-items: flex-start; }
.dashboard-column { flex-grow: 1; min-width: 0; }
.dashboard-widget { margin-bottom: 10dp; pointer-events: auto; }
.dashboard-widget.dragging { opacity: 0.65; border-color: #ff0021; }
.dashboard-widget-title { display: flex; flex-direction: row; align-items: center; margin-bottom: 7dp; }
.dashboard-widget-title .name { flex-grow: 1; font-weight: 700; }
.dashboard-edit-zone { min-height: 38dp; border: 1dp #ff002166; border-radius: 6dp; padding: 7dp; color: #707987; margin-bottom: 8dp; }
.dashboard-drop-slot { height: 10dp; margin: -3dp 5dp; border-top: 2dp transparent; }
.dashboard-drop-slot:hover { border-top-color: #ff0021; }
.dashboard-drop-slot.end { margin-top: 1dp; margin-bottom: 5dp; }
.toolbox-draggable { cursor: move; border: 1dp transparent; border-radius: 4dp; padding: 2dp; }
.toolbox-draggable:hover { border-color: #ffffff22; background-color: #ffffff08; }
.dashboard-hidden { padding: 8dp; border-top: 1dp #2b303d; }
.dashboard-modal { position: absolute; left: 0; top: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background-color: #00000070; pointer-events: auto; }
.update-dialog { width: 470dp; max-width: 92%; background-color: #151820f5; }

button, .button {
    min-height: 27dp;
    padding: 4dp 9dp;
    background-color: #202530;
    border: 1dp #323947;
    border-radius: 5dp;
    color: #eef1f5;
    cursor: pointer;
    text-align: center;
}
button:hover, .button:hover { background-color: #2a303d; border-color: #485164; }
button:active, .button:active { background-color: #181c24; }
button.primary, .button.primary { background-color: #c9001b; border-color: #ef1734; }
button.danger, .button.danger { background-color: #35171a; border-color: #743238; color: #ff8e95; }
button.ghost, .button.ghost { background-color: transparent; }
button.compact { min-height: 23dp; padding: 2dp 7dp; font-size: 10dp; }
button.window-control { width: 32dp; min-width: 32dp; padding: 3dp; margin-left: 3dp; font-size: 15dp; }
.widget-controls { margin-bottom: 7dp; }
.compact-select { min-width: 118dp; height: 25dp; font-size: 11dp; }
button:disabled { color: #606978; background-color: #161920; border-color: #242936; cursor: unavailable; }

.modal-layer { pointer-events: none; }
.modal-backdrop {
    position: absolute;
    left: 0; top: 0; width: 100%; height: 100%;
    background-color: #00000070;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
}
.settings-window {
    position: absolute;
    display: flex;
    flex-direction: column;
    width: 900dp;
    max-width: 94%;
    height: 650dp;
    max-height: 92%;
    background-color: #0c0f14fa;
    border: 1dp #303744;
    border-radius: 11dp;
    overflow: hidden;
}
.settings-header {
    height: 58dp;
    min-height: 58dp;
    padding: 11dp 16dp;
    background-color: #11151c;
    border-bottom: 1dp #272d38;
    cursor: move;
}
.settings-header button { cursor: pointer; }
.settings-header > .grow { display: flex; flex-direction: column; justify-content: center; }
.settings-header .brand-title { font-size: 17dp; }
.settings-header .label { font-size: 9dp; margin-top: 1dp; }
.settings-body { display: flex; flex-direction: row; flex-grow: 1; min-height: 0; }
.settings-nav {
    width: 152dp;
    min-width: 152dp;
    padding: 11dp 8dp;
    background-color: #0e1117;
    border-right: 1dp #252b35;
}
.settings-nav button {
    display: block;
    width: 100%;
    min-height: 32dp;
    padding: 6dp 9dp;
    text-align: left;
    margin: 0 0 3dp 0;
    border-color: transparent;
    border-radius: 5dp;
    background-color: transparent;
    color: #939dab;
    font-size: 11dp;
    line-height: 1.15;
}
.settings-nav button:hover { color: #eef1f5; background-color: #171c24; border-color: #242b37; }
.settings-nav button.active { border-color: #5d1a25; color: #ffffff; background-color: #251218; }
.settings-page {
    flex-grow: 1;
    min-width: 0;
    padding: 12dp 14dp 18dp 14dp;
    overflow-y: auto;
    background-color: #0a0d12;
}
.settings-footer {
    height: 48dp;
    min-height: 48dp;
    padding: 8dp 13dp;
    border-top: 1dp #272d38;
    background-color: #10141a;
    display: flex;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    gap: 7dp;
}
.setting-section {
    display: block;
    margin-bottom: 10dp;
    padding: 9dp 11dp;
    background-color: #11151b;
    border: 1dp #232a35;
    border-radius: 7dp;
}
.setting-title {
    display: block;
    font-weight: 700;
    font-size: 11dp;
    color: #ff1838;
    margin-bottom: 5dp;
    line-height: 1.2;
}
.setting-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 37dp;
    padding: 4dp 1dp;
    border-bottom: 1dp #262c3555;
}
.setting-info { display: flex; flex-direction: column; justify-content: center; flex-grow: 1; min-width: 0; padding-right: 16dp; }
.setting-name { display: block; color: #edf1f6; font-size: 11dp; font-weight: 600; line-height: 1.2; }
.setting-help { display: block; color: #747e8c; font-size: 9dp; line-height: 1.25; margin-top: 2dp; }
.settings-page select { min-width: 155dp; max-width: 270dp; }
.settings-page input.text, .settings-page input.password { min-width: 190dp; max-width: 320dp; }
.rank-table { margin-top: 7dp; border: 1dp #2c3240; border-radius: 5dp; overflow: hidden; }
.rank-table-row { display: flex; flex-direction: row; min-height: 24dp; align-items: center; border-top: 1dp #252a3555; }
.rank-table-row:first-child { border-top: 0; }
.rank-table-row.header { background-color: #10131a; color: #9da6b3; font-size: 9dp; font-weight: 700; }
.rank-table-row > div { flex-grow: 1; width: 25%; padding: 3dp 6dp; font-size: 10dp; }

input.text, input.password, select {
    height: 28dp;
    padding: 4dp 7dp;
    background-color: #0f1218;
    border: 1dp #343b49;
    border-radius: 4dp;
    color: #eef1f5;
}
input.text:focus, input.password:focus, select:focus, select:checked { border-color: #ff0021; }

/* RmlUi intentionally ships form controls without a visual theme. Style the
   generated control elements here so the native settings UI remains complete
   without pulling in the sample/demo stylesheets. */
input.checkbox {
    width: 30dp;
    min-width: 30dp;
    height: 17dp;
    margin-left: 8dp;
    border: 1dp #454c5a;
    border-radius: 8dp;
    background-color: #252a34;
    cursor: pointer;
}
input.checkbox:hover { border-color: #626c7e; background-color: #2f3541; }
input.checkbox:checked { border-color: #ff2340; background-color: #b5001a; }
input.checkbox:disabled { border-color: #303642; background-color: #1b1f27; cursor: unavailable; opacity: 0.55; }

input.range {
    width: 180dp;
    height: 20dp;
    padding: 0;
    background-color: transparent;
    border: 0;
}
input.range sliderarrowdec, input.range sliderarrowinc { width: 0; height: 0; }
input.range slidertrack {
    height: 4dp;
    margin-top: 8dp;
    border-radius: 2dp;
    background-color: #2d3441;
}
input.range sliderprogress {
    height: 4dp;
    border-radius: 2dp;
    background-color: #a90017;
}
input.range sliderbar {
    width: 14dp;
    height: 14dp;
    margin-top: -5dp;
    border: 2dp #ff0021;
    border-radius: 7dp;
    background-color: #eef1f5;
    cursor: move;
}
input.range sliderbar:hover, input.range sliderbar:active { background-color: #ffffff; }

select { padding: 0; }
select selectvalue {
    height: 26dp;
    padding: 4dp 26dp 4dp 7dp;
    color: #eef1f5;
    background-color: #0f1218;
}
select selectarrow {
    width: 22dp;
    height: 26dp;
    margin-left: -22dp;
    border-left: 1dp #343b49;
    background-color: #181d26;
    cursor: pointer;
}
select selectarrow:hover, select:checked selectarrow { background-color: #252c38; }
select selectbox {
    margin-top: 2dp;
    min-width: 100%;
    max-height: 250dp;
    overflow-y: auto;
    padding: 3dp;
    border: 1dp #343b49;
    border-radius: 4dp;
    background-color: #11151c;
}
select selectbox option {
    min-height: 25dp;
    padding: 5dp 7dp;
    border-radius: 3dp;
    color: #dce1e8;
    background-color: transparent;
}
select selectbox option:hover { background-color: #252c38; }
select selectbox option:checked { background-color: #35131a; color: #ffffff; }

scrollbarvertical {
    width: 9dp;
    margin-left: 2dp;
    background-color: #0b0e13aa;
}
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0; height: 0; }
scrollbarvertical slidertrack { width: 7dp; margin-left: 1dp; background-color: transparent; }
scrollbarvertical sliderbar {
    width: 7dp;
    min-height: 28dp;
    border-radius: 4dp;
    background-color: #3b4352cc;
}
scrollbarvertical sliderbar:hover { background-color: #596376dd; }
scrollbarvertical sliderbar:active { background-color: #ff0021cc; }

scrollbarhorizontal {
    height: 9dp;
    margin-top: 2dp;
    background-color: #0b0e13aa;
}
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc { width: 0; height: 0; }
scrollbarhorizontal slidertrack { height: 7dp; margin-top: 1dp; background-color: transparent; }
scrollbarhorizontal sliderbar {
    height: 7dp;
    min-width: 28dp;
    border-radius: 4dp;
    background-color: #3b4352cc;
}
scrollbarhorizontal sliderbar:hover { background-color: #596376dd; }
scrollbarhorizontal sliderbar:active { background-color: #ff0021cc; }
scrollbarcorner { background-color: #0b0e13aa; }

.color-dot { width: 20dp; height: 20dp; border: 1dp #ffffff33; border-radius: 4dp; }
.color-dot-button { min-width: 20dp; padding: 0; margin: 0; }
.color-editor-preview { width: 100%; height: 28dp; border: 1dp #ffffff33; border-radius: 5dp; margin: 4dp 0 8dp 0; }
.color-channel { display: flex; flex-direction: row; align-items: center; min-height: 27dp; gap: 8dp; }
.color-channel-label { width: 14dp; font-family: "Consolas"; font-size: 10dp; color: #9da6b3; }
.color-range { flex-grow: 1; width: auto; }
.color-channel-value { width: 30dp; text-align: right; color: #9da6b3; }

.graph-wrap { position: relative; height: 220dp; background-color: #0d1016; border: 1dp #242a35; border-radius: 6dp; overflow: hidden; }
.graph-empty { min-height: 150dp; display: flex; flex-direction: column; justify-content: center; gap: 4dp; padding: 0 8dp; }
.graph-gridline { position: absolute; height: 1dp; background-color: #69728055; }
.graph-label { position: absolute; color: #697280; font-family: "Consolas"; font-size: 9dp; }
.graph-last { text-align: right; }
.graph-polyline { display: block; position: absolute; left: 0; top: 0; width: 100%; height: 100%; color: #5480d8; pointer-events: none; }
.graph-line { position: absolute; height: 2dp; background-color: #5480d8; transform-origin: left center; opacity: 0.88; }
.graph-line.baseline { height: 1dp; background-color: #e8f300; opacity: 0.48; }
.graph-point { position: absolute; width: 8dp; height: 8dp; margin-left: -4dp; margin-top: -4dp; border-radius: 5dp; background-color: #5480d8; }
.graph-point.win { background-color: #43d926; }
.graph-point.loss { background-color: #ff3030; }
.graph-point.neutral { background-color: #9da6b3; }
.graph-point.current { width: 12dp; height: 12dp; margin-left: -6dp; margin-top: -6dp; border-radius: 7dp; }
.graph-point.estimated { background-color: transparent; border: 2dp #eef1f5; }
.graph-point-halo { position: absolute; width: 20dp; height: 20dp; margin-left: -10dp; margin-top: -10dp; border-radius: 11dp; background-color: #5480d8; opacity: 0.20; }
.graph-point-halo.win { background-color: #43d926; }
.graph-point-halo.loss { background-color: #ff3030; }
.graph-point-halo.neutral { background-color: #9da6b3; }
.graph-current { position: absolute; font-family: "Consolas"; font-size: 12dp; font-weight: 700; white-space: nowrap; }

.previous-games-header { min-height: 27dp; margin-bottom: 3dp; }
.previous-games-header .card-title { margin-bottom: 0; }
.match-row { display: flex; flex-direction: row; align-items: center; min-height: 24dp; padding: 1dp 2dp; font-size: 10dp; border-top: 1dp #252a3555; }
.match-header { min-height: 22dp; color: #707987; font-size: 9dp; font-weight: 700; }
.match-header .match-mode, .match-header .match-score, .match-header .match-mmr, .match-header .match-time { color: #707987; font-family: "Segoe UI"; }
.match-mode { width: 108dp; flex-shrink: 0; color: #9da6b3; padding-left: 4dp; }
.match-score { width: 58dp; flex-shrink: 0; text-align: center; font-family: "Consolas"; }
.match-mmr { width: 68dp; flex-shrink: 0; text-align: center; font-family: "Consolas"; }
.match-time { flex-grow: 1; min-width: 52dp; text-align: right; color: #707987; font-size: 10dp; }
.match-data { min-height: 27dp; border-top: 0; }
.match-data.match-even { background-color: #11151a99; }
.match-data.match-odd { background-color: #090c1099; }
.match-data:hover { background-color: #1a2028cc; }
.match-win .match-mode, .match-win .match-score, .match-win .match-mmr, .match-win .match-time { color: #43d926; }
.match-loss .match-mode, .match-loss .match-score, .match-loss .match-mmr, .match-loss .match-time { color: #ff3030; }
.previous-games-footer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 30dp;
    margin-top: 8dp;
    padding: 7dp 2dp 1dp 2dp;
    border-top: 1dp #2a303a;
    color: #9da6b3;
    font-size: 9dp;
    font-family: "Consolas";
}

.toast-root { pointer-events: none; }
.toast { position: absolute; right: 14dp; bottom: 14dp; width: 330dp; background-color: #141820f5; border: 1dp #323a49; border-radius: 7dp; padding: 9dp 11dp; }
.toast.error { border-color: #7d3037; }
.toast.success { border-color: #397d30; }

@media (max-width: 850dp) {
    .settings-window { width: 96%; height: 94%; }
    .settings-nav { width: 145dp; }
    .dashboard-columns { flex-direction: column; }
    .dashboard-column { width: 100%; }
}

/* Native rank badge parity: tier crest + four-step Rocket League division stack. */
.rank-badge { display: flex; flex-direction: row; align-items: center; flex-shrink: 0; margin-right: 8dp; min-width: 45dp; }
.rank-badge .rank-icon { margin-right: 3dp; }
.division-stack { width: 11dp; display: flex; flex-direction: column; justify-content: center; gap: 1dp; }
.division-pill { width: 11dp; height: 3dp; }
.tooltip-host { position: relative; }
.tooltip-bubble {
    display: none;
    position: absolute;
    z-index: 200;
    left: 50%;
    bottom: 100%;
    width: auto;
    min-width: 120dp;
    max-width: 260dp;
    margin-left: -60dp;
    margin-bottom: 5dp;
    padding: 5dp 7dp;
    background-color: #07090df2;
    border: 1dp #3a4252;
    border-radius: 4dp;
    color: #eef1f5;
    font-size: 10dp;
    font-family: "Segoe UI";
    white-space: nowrap;
    pointer-events: none;
}
.tooltip-host:hover .tooltip-bubble { display: block; }

.controller-debug { margin-top: 10dp; padding-top: 8dp; border-top: 1dp #2b303d; }
.debug-grid { display: flex; flex-direction: column; margin-top: 5dp; font-size: 10dp; }
.debug-row { display: flex; flex-direction: row; margin-top: 3dp; }
.debug-label { width: 135dp; color: #9da6b3; }
.debug-value { flex-grow: 1; color: #eef1f5; font-family: "Consolas"; }
.privacy-dialog { width: 520dp; max-width: 92%; }
