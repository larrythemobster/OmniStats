<rml>
<head>
    <title>OmniStats Insights</title>
    <link type="text/rcss" href="res://omnistats.rcss" />
</head>
<body id="app" class="view-document" data-model="insights">
    <div class="view-backdrop">
        <div class="view-window">
            <div class="view-header row">
                <div class="grow">
                    <div class="brand-title">Insights</div>
                    <div class="label">{{subtitle}}</div>
                </div>
                <button class="ghost compact" data-action="insights-close">Close</button>
            </div>
            <div class="view-tabs row">
                <button class="tab-button" data-action="insights-tab" data-tab="recap" data-class-active="tab == 'recap'">Session recap</button>
                <button class="tab-button" data-action="insights-tab" data-tab="sessions" data-class-active="tab == 'sessions'">Sessions</button>
                <button class="tab-button" data-action="insights-tab" data-tab="people" data-class-active="tab == 'people'">People</button>
                <button class="tab-button" data-action="insights-tab" data-tab="trends" data-class-active="tab == 'trends'">Trends</button>
            </div>

            <div class="view-body" data-if="tab == 'recap'">
                <div class="row gap-sm recap-stepper" data-if="recap_can_step">
                    <button class="ghost compact" data-action="recap-prev-session" data-attr-disabled="!recap_can_prev">&#x2039;</button>
                    <div class="label mono">{{recap_step_label}}</div>
                    <button class="ghost compact" data-action="recap-next-session" data-attr-disabled="!recap_can_next">&#x203A;</button>
                    <div class="label grow">{{recap_title}}</div>
                </div>
                <div id="recap-card" class="recap-card">
                    <div class="recap-inner">
                        <div class="recap-head row">
                            <div class="grow">
                                <div class="recap-title">{{recap_title}}</div>
                                <div class="recap-date">{{recap_date}}</div>
                            </div>
                            <div class="recap-brand">OmniStats</div>
                        </div>
                        <div data-if="recap_has_games">
                            <div class="recap-hero row">
                                <div class="grow">
                                    <div class="recap-record"><span class="win">{{recap_wins}}</span><span class="recap-dash">-</span><span class="loss">{{recap_losses}}</span></div>
                                    <div class="recap-games">{{recap_games}}</div>
                                </div>
                                <div class="recap-hero-stat">
                                    <div class="recap-hero-value">{{recap_rate}}</div>
                                    <div class="recap-hero-label">Win rate</div>
                                </div>
                                <div class="recap-hero-divider"></div>
                                <div class="recap-hero-stat">
                                    <div class="recap-hero-value" data-class-win="recap_mmr_tone == 1" data-class-loss="recap_mmr_tone == -1">{{recap_mmr}}</div>
                                    <div class="recap-hero-label">MMR change</div>
                                </div>
                            </div>
                            <div class="recap-bar"><div class="recap-bar-fill" data-style-width="recap_win_width"></div></div>
                            <div class="recap-strip">
                                <div class="recap-strip-cell" data-for="stat : recap_stats">
                                    <div class="recap-strip-value">{{stat.value}}</div>
                                    <div class="recap-strip-label">{{stat.label}}</div>
                                </div>
                            </div>
                            <div class="recap-modes" data-if="recap_modes.size > 0">
                                <div class="recap-section-title">By playlist</div>
                                <div class="recap-mode-row" data-for="mode : recap_modes">
                                    <div class="recap-mode-name">{{mode.name}}</div>
                                    <div class="recap-mode-track" data-class-empty="mode.win_width == ''"><div class="recap-bar-fill" data-style-width="mode.win_width"></div></div>
                                    <div class="recap-mode-record">{{mode.record}}</div>
                                    <div class="recap-mode-mmr" data-class-win="mode.tone == 1" data-class-loss="mode.tone == -1">{{mode.mmr}}</div>
                                </div>
                            </div>
                            <div class="recap-compare" data-if="recap_comparing && recap_compare_rows.size > 0">
                                <div class="recap-section-title">{{recap_compare_title}}</div>
                                <div class="recap-compare-row" data-for="cmp : recap_compare_rows">
                                    <div class="recap-compare-label">{{cmp.label}}</div>
                                    <div class="recap-compare-val mono">{{cmp.current_val}}</div>
                                    <div class="recap-compare-prev mono muted">vs {{cmp.previous_val}}</div>
                                    <div class="recap-compare-delta mono" data-class-win="cmp.tone == 1" data-class-loss="cmp.tone == -1">{{cmp.delta}}</div>
                                </div>
                            </div>
                        </div>
                        <div class="recap-empty" data-if="!recap_has_games">No games this session yet. Play a match and the recap fills in here.</div>
                        <div class="recap-foot">omnistats.org</div>
                    </div>
                </div>
                <div class="row gap-sm view-actions" data-if="recap_has_games">
                    <button class="primary" data-action="recap-export">Save as PNG</button>
                    <button class="ghost" data-if="recap_can_compare" data-action="recap-compare" data-class-active="recap_comparing">Compare with previous</button>
                    <div class="label grow">Saves to Pictures\OmniStats so you can drop it into Discord.</div>
                </div>
            </div>

            <div class="view-body" data-if="tab == 'sessions'">
                <div class="sessions-table" data-if="sessions.size > 0">
                    <div class="session-row header">
                        <div class="session-date-col">Session</div>
                        <div class="session-cell">Games</div>
                        <div class="session-cell">Record</div>
                        <div class="session-bar-col">Win rate</div>
                        <div class="session-playlists-col">By playlist</div>
                        <div class="session-cell">Net MMR</div>
                    </div>
                    <div data-for="session : sessions">
                        <div class="session-row item" data-action="session-open" data-attr-data-session-index="session.index" data-class-selected="session.selected">
                            <div class="session-date-col">
                                <div class="row gap-xs">
                                    <span class="value">{{session.date}}</span>
                                    <span class="badge session-badge" data-if="session.badge != ''" data-class-win="session.badge_kind == 'best'" data-class-loss="session.badge_kind == 'worst'" data-class-accent="session.badge_kind == 'live'">{{session.badge}}</span>
                                </div>
                                <div class="label">{{session.time_range}}</div>
                            </div>
                            <div class="session-cell mono">{{session.games}}</div>
                            <div class="session-cell mono">{{session.record}}</div>
                            <div class="session-bar-col">
                                <div class="session-bar-track"><div class="recap-bar-fill" data-style-width="session.win_width"></div></div>
                                <div class="session-rate mono">{{session.rate}}</div>
                            </div>
                            <div class="session-playlists-col">
                                <div class="session-mmr-list" data-if="session.playlist_mmrs.size > 0">
                                    <span class="session-mmr-pill mono" data-for="pm : session.playlist_mmrs" data-class-win="pm.tone == 1" data-class-loss="pm.tone == -1">{{pm.label}}</span>
                                </div>
                                <span class="mono muted" data-if="session.playlist_mmrs.size == 0">--</span>
                            </div>
                            <div class="session-cell mono" data-class-win="session.mmr_tone == 1" data-class-loss="session.mmr_tone == -1">{{session.mmr}}</div>
                        </div>
                    </div>
                </div>
                <div class="row gap-sm view-actions" data-if="sessions_has_more">
                    <button class="ghost" data-action="sessions-load-more">Load more</button>
                </div>
                <div class="muted view-empty" data-if="sessions.size == 0">{{sessions_empty}}</div>
            </div>

            <div class="view-body" data-if="tab == 'people'">
                <div class="row gap-sm view-filters">
                    <button class="tab-button pill" data-action="people-filter" data-filter="teammates" data-class-active="people_filter == 'teammates'">Teammates</button>
                    <button class="tab-button pill" data-action="people-filter" data-filter="rivals" data-class-active="people_filter == 'rivals'">Opponents</button>
                </div>
                <div class="people-table" data-if="people.size > 0">
                    <div class="people-row header">
                        <div class="people-name"><div>Player</div></div>
                        <div class="people-cell">Games</div>
                        <div class="people-cell">Record</div>
                        <div class="people-cell">Win rate</div>
                        <div class="people-cell wide">Last played</div>
                    </div>
                    <div class="people-row" data-for="person : people">
                        <div class="people-name">
                            <span class="value">{{person.name}}</span>
                            <span class="label people-platform">{{person.platform}}</span>
                        </div>
                        <div class="people-cell mono">{{person.games}}</div>
                        <div class="people-cell mono">{{person.record}}</div>
                        <div class="people-cell mono" data-class-win="person.tone == 1" data-class-loss="person.tone == -1">{{person.rate}}</div>
                        <div class="people-cell wide label">{{person.last_seen}}</div>
                    </div>
                </div>
                <div class="muted view-empty" data-if="people.size == 0">{{people_empty}}</div>
            </div>

            <div class="view-body" data-if="tab == 'trends'">
                <div class="row gap-sm view-filters">
                    <button class="tab-button pill" data-for="playlist : trend_playlists" data-action="trend-playlist-filter" data-attr-data-playlist="playlist.id" data-class-active="trend_playlist_filter == playlist.id">{{playlist.label}}</button>
                </div>
                <div class="callout" data-if="tilt_message != ''">{{tilt_message}}</div>
                <div class="callout" data-if="gap_callout != ''">{{gap_callout}}</div>
                <div class="label trends-summary">{{trends_summary}}</div>
                <div class="trend-section" data-for="section : trend_sections">
                    <div class="row gap-sm">
                        <div class="stat-section-title">{{section.title}}</div>
                        <div class="label tooltip-host" data-if="section.subtitle != ''">
                            <span>{{section.subtitle}}</span>
                            <div class="tooltip-bubble" data-if="section.tooltip != ''">{{section.tooltip}}</div>
                        </div>
                    </div>
                    <div class="trend-row" data-for="row : section.rows">
                        <div class="trend-label">{{row.label}}</div>
                        <div class="trend-track">
                            <div class="trend-bar" data-style-width="row.width" data-class-win="row.tone == 1" data-class-loss="row.tone == -1"></div>
                        </div>
                        <div class="trend-rate mono">{{row.rate}}</div>
                        <div class="trend-games label">{{row.games}}</div>
                    </div>
                </div>
                <div class="muted view-empty" data-if="trend_sections.size == 0">{{trends_empty}}</div>
            </div>
        </div>
    </div>
</body>
</rml>
