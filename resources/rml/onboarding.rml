<rml>
<head>
    <title>Welcome to OmniStats</title>
    <link type="text/rcss" href="res://omnistats.rcss" />
</head>
<body id="app" class="view-document" data-model="onboarding">
    <div class="view-backdrop wizard-backdrop">
        <div class="view-window wizard-window">
            <div class="view-header wizard-header row">
                <img class="brand-logo" src="res://images/Logo.png" />
                <div class="grow">
                    <div class="brand-title">OmniStats <span class="dim">Setup</span></div>
                    <div class="label" data-if="consent_required">Welcome</div>
                    <div class="label" data-if="!consent_required">Step {{step + 1}} of {{total_steps}} · {{step_title}}</div>
                </div>
                <button class="ghost compact" data-if="!consent_required" data-action="onboarding-finish">Skip setup</button>
            </div>

            <div class="wizard-main" data-if="consent_required">
                <div class="view-body">
                    <div class="wizard-title">Welcome to OmniStats</div>
                    <div class="wizard-lead">Before you start, here is what OmniStats sends and what stays on this PC.</div>
                    <div class="status-card consent-card">
                        <div class="setting-name">Sent each time OmniStats starts</div>
                        <div class="setting-help">App version, a random install ID, and which features are turned on. Match data and player names are not included.</div>
                    </div>
                    <div class="status-card consent-card">
                        <div class="setting-name">Off until you turn it on</div>
                        <div class="setting-help">Tracker Network ranks, Discord, Ballchasing, crash reports, and automatic updates. Update checks always run.</div>
                    </div>
                    <div class="row gap-sm view-actions">
                        <button class="ghost compact" data-action="open-legal-link" data-url="https://omnistats.org/privacy">Privacy Policy</button>
                        <button class="ghost compact" data-action="open-legal-link" data-url="https://omnistats.org/terms">Terms of Use</button>
                    </div>
                </div>
                <div class="wizard-footer row">
                    <button class="ghost" data-action="onboarding-exit">Exit</button>
                    <div class="grow consent-note">By continuing you accept the Privacy Policy and Terms of Use.</div>
                    <button class="primary" data-action="onboarding-accept-terms">Accept and continue</button>
                </div>
            </div>

            <div class="wizard-main" data-if="!consent_required">
            <div class="wizard-progress row" data-if="omninet_available">
                <div class="wizard-step" data-class-done="step >= 0"></div>
                <div class="wizard-step" data-class-done="step >= 1"></div>
                <div class="wizard-step" data-class-done="step >= 2"></div>
                <div class="wizard-step" data-class-done="step >= 3"></div>
                <div class="wizard-step" data-class-done="step >= 4"></div>
            </div>
            <div class="wizard-progress row" data-if="!omninet_available">
                <div class="wizard-step" data-class-done="step >= 0"></div>
                <div class="wizard-step" data-class-done="step >= 1"></div>
                <div class="wizard-step" data-class-done="step >= 2"></div>
                <div class="wizard-step" data-class-done="step >= 3"></div>
            </div>

            <div class="view-body" data-if="step == 0">
                <div class="wizard-lead">OmniStats reads live match data from Rocket League's local Stats API. It needs to be switched on once.</div>
                <div class="status-card" data-class-ok="stats_ok" data-class-bad="!stats_ok">
                    <div class="row">
                        <div class="status-dot"></div>
                        <div class="grow value">{{stats_status}}</div>
                    </div>
                    <div class="label mono status-path">{{stats_path}}</div>
                    <div class="setting-help loss" data-if="stats_message != ''">{{stats_message}}</div>
                    <div class="setting-help" data-if="show_restart_hint">Restart Rocket League after fixing the config.</div>
                </div>
                <div class="row gap-sm view-actions">
                    <button class="primary" data-if="stats_can_fix" data-action="onboarding-statsapi-fix">Fix it for me</button>
                    <button data-action="onboarding-statsapi-check">Check again</button>
                    <button data-if="!stats_ok" data-action="onboarding-statsapi-browse">Choose file...</button>
                </div>
            </div>

            <div class="view-body" data-if="step == 1">
                <div class="wizard-lead">Where should OmniStats show your stats? You can switch any time from Settings or the tray icon.</div>
                <div class="row gap-md">
                    <div class="choice-card grow" data-action="onboarding-layout" data-mode="overlay" data-class-selected="!second_monitor">
                        <div class="choice-title">In-game overlay</div>
                        <div class="setting-help">A transparent layer on top of Rocket League. Press Tab to show your roster and ranks mid-match.</div>
                    </div>
                    <div class="choice-card grow" data-action="onboarding-layout" data-mode="dashboard" data-class-selected="second_monitor">
                        <div class="choice-title">Second-monitor dashboard</div>
                        <div class="setting-help">A normal window with every card laid out at once. Best if you have a spare screen.</div>
                    </div>
                </div>
            </div>

            <div class="view-body" data-if="omninet_available && step == 2">
                <div class="wizard-lead" data-if="!account_awaiting && !account_signed_in && !account_migrating">Sign in to OmniStats to see player ranks and MMR. Your match history stays on this PC.</div>
                <div class="wizard-lead" data-if="account_migrating">Connecting to OmniStats...</div>
                <div class="wizard-lead" data-if="account_awaiting">Finish connecting in your browser</div>
                <div class="wizard-lead" data-if="account_signed_in">Connected to OmniStats</div>

                <div class="status-card account-onboarding-card" data-if="!account_signed_in && !account_awaiting && !account_migrating">
                    <div class="row">
                        <div class="grow">
                            <div class="row gap-xs">
                                <div class="setting-name">Connect live ranks</div>
                                <span class="badge win">Recommended</span>
                            </div>
                            <div class="setting-help">Use an OmniStats account, not your Epic Games or Rocket League login.</div>
                            <div class="setting-help loss" data-if="account_has_error">{{account_status}}</div>
                        </div>
                    </div>
                    <div class="row gap-sm view-actions">
                        <button class="primary" data-action="account-sign-in">Continue in browser</button>
                        <button class="ghost" data-action="onboarding-next">Set up later</button>
                    </div>
                </div>

                <div class="status-card account-onboarding-card" data-if="account_migrating">
                    <div class="row">
                        <div class="grow">
                            <div class="setting-name">Upgrading account connection...</div>
                            <div class="setting-help">Linking this PC using your saved account credentials.</div>
                        </div>
                    </div>
                    <div class="row gap-sm view-actions">
                        <button class="ghost" disabled="disabled">Connecting...</button>
                    </div>
                </div>

                <div class="status-card account-onboarding-card" data-if="account_awaiting">
                    <div class="row">
                        <div class="grow">
                            <div class="setting-help">Sign in or create an account, then approve this PC. This screen will update automatically.</div>
                        </div>
                    </div>
                    <div class="row gap-sm view-actions">
                        <button class="primary" data-action="account-open-verify">Open browser again</button>
                        <button class="ghost" data-action="account-cancel">Cancel</button>
                    </div>
                    <div class="account-fallback-wrap" style="margin-top: 10dp;">
                        <button class="ghost compact" data-action="account-toggle-fallback">Browser didn't open?</button>
                        <div class="account-code-card" data-if="account_show_fallback">
                            <div class="setting-help">Paste the sign-in link into your browser. It already includes this code.</div>
                            <div class="label">Verification code</div>
                            <div class="account-user-code mono">{{account_user_code}}</div>
                            <div class="row gap-xs center" style="margin-top: 8dp;">
                                <button class="ghost compact" data-action="account-copy-code">Copy code</button>
                                <button class="primary compact" data-action="account-copy-link">Copy sign-in link</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="status-card account-onboarding-card" data-if="account_signed_in" data-class-ok="true">
                    <div class="row">
                        <div class="grow">
                            <div class="setting-name win">Connected as {{account_display_name}}</div>
                            <div class="setting-help win" data-if="custom_api_enabled">OmniStats live ranks are active.</div>
                            <div class="setting-help" data-if="!custom_api_enabled">OmniStats rank API is disabled in Settings.</div>
                        </div>
                        <button class="ghost compact" data-action="account-sign-out">Sign out</button>
                    </div>
                    <div class="row gap-sm view-actions">
                        <button class="primary" data-action="onboarding-next">Continue</button>
                    </div>
                </div>
            </div>

            <div class="view-body" data-if="(omninet_available && step == 3) || (!omninet_available && step == 2)">
                <div class="wizard-lead">These are optional and off by default. Each one sends data somewhere else, so turn on only what you want.</div>
                <div class="setting-row">
                    <div class="setting-info">
                        <div class="setting-name">Tracker Network rank lookup</div>
                        <div class="setting-help">Sends lobby player names and platform IDs to Tracker Network to look up public ranks.</div>
                    </div>
                    <div class="toggle-switch"><input type="checkbox" class="checkbox" data-setting="enable_mmr_tracking" data-checked="mmr_tracking" /><span class="toggle-thumb"></span></div>
                </div>
                <div class="setting-row">
                    <div class="setting-info">
                        <div class="setting-name">Discord Rich Presence</div>
                        <div class="setting-help">Shows your current match on your Discord profile. Takes effect after a restart.</div>
                    </div>
                    <div class="toggle-switch"><input type="checkbox" class="checkbox" data-setting="discord_rpc_enabled" data-checked="discord" /><span class="toggle-thumb"></span></div>
                </div>
                <div class="setting-row">
                    <div class="setting-info">
                        <div class="setting-name">Crash reports</div>
                        <div class="setting-help">Uploads crash dumps on the next start. Dumps can contain process memory.</div>
                    </div>
                    <div class="toggle-switch"><input type="checkbox" class="checkbox" data-setting="crash_reports_enabled" data-checked="crash_reports" /><span class="toggle-thumb"></span></div>
                </div>
                <div class="setting-row">
                    <div class="setting-info">
                        <div class="setting-name">Automatically install updates</div>
                        <div class="setting-help">Installs updates the next time OmniStats starts.</div>
                    </div>
                    <div class="toggle-switch"><input type="checkbox" class="checkbox" data-setting="enable_auto_updates" data-checked="auto_updates" /><span class="toggle-thumb"></span></div>
                </div>
            </div>

            <div class="view-body" data-if="(omninet_available && step == 4) || (!omninet_available && step == 3)">
                <div class="wizard-lead">OmniStats tracks match history for your Rocket League account. Leave this on auto-detect and it picks you up in your first match.</div>
                <div id="onboarding-identity"></div>
                <div class="setting-help">{{identity_hint}}</div>
            </div>

            <div class="wizard-footer row">
                <button class="ghost" data-if="step > 0" data-action="onboarding-back">Back</button>
                <div class="grow"></div>
                <button class="primary" data-if="step < total_steps - 1 && (!omninet_available || step != 2)" data-action="onboarding-next">Next</button>
                <button class="primary" data-if="omninet_available && step == 2 && account_signed_in" data-action="onboarding-next">Continue</button>
                <button class="primary" data-if="step == total_steps - 1" data-action="onboarding-finish">Finish</button>
            </div>
            </div>
        </div>
    </div>
</body>
</rml>
