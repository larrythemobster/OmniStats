<rml>
<head>
    <title>OmniStats Player Scout</title>
    <link type="text/rcss" href="res://omnistats.rcss" />
</head>
<body id="app" class="view-document" data-model="player_note">
    <div class="view-backdrop" data-if="open">
        <div class="card player-note-card">
            <div class="row gap-sm player-note-header">
                <div class="grow player-note-identity">
                    <div class="row gap-sm" style="align-items:center">
                        <span class="brand-title player-note-name">{{player_name}}</span>
                        <span data-attr-class="platform_class" data-if="platform_label != ''">{{platform_label}}</span>
                    </div>
                    <div class="label" data-if="account_label != ''">{{account_label}}</div>
                    <div class="label player-note-context" data-if="context != '' && !available">{{context}}</div>
                </div>
                <button class="ghost compact" data-action="player-note-close">Close</button>
            </div>

            <div class="callout" data-if="!available">{{unavailable_message}}</div>

            <div class="player-note-body" data-if="available">
                <div class="scout-section">
                    <div class="row scout-section-head">
                        <span class="stat-section-title grow">MATCH HISTORY TOGETHER</span>
                        <span class="label" data-if="scout_rank != ''">Current rank: <span class="value" data-style-color="scout_rank_color">{{scout_rank}}</span></span>
                    </div>
                    <div class="muted" data-if="scout_loading">{{scout_status}}</div>
                    <div class="label loss" data-if="!scout_loading && !scout_ready">{{scout_status}}</div>
                    <div data-if="scout_ready">
                        <div class="scout-stats">
                            <div class="scout-stat"><span class="label">Games</span><span class="value mono">{{scout_encounters}}</span></div>
                            <div class="scout-stat"><span class="label">With</span><span class="value mono">{{scout_with}}</span></div>
                            <div class="scout-stat"><span class="label">Vs</span><span class="value mono">{{scout_against}}</span></div>
                            <div class="scout-stat"><span class="label">Last seen</span><span class="value">{{scout_last}}</span></div>
                        </div>
                        <div class="label scout-playlist" data-if="scout_playlist != ''">Mostly played in {{scout_playlist}}</div>
                        <div class="muted" data-if="scout_recent.size == 0">No saved matches with this player yet.</div>
                        <div class="scout-recent" data-if="scout_recent.size > 0">
                            <div class="row scout-encounter" data-for="match : scout_recent" data-action="player-scout-open-match" data-attr-data-id="match.match_id">
                                <span class="mono scout-outcome" data-class-win="match.win" data-class-loss="!match.win">{{match.outcome}}</span>
                                <span class="value grow scout-playlist-name">{{match.playlist}}</span>
                                <span class="label scout-relation">{{match.relation}}</span>
                                <span class="label scout-when">{{match.when}}</span>
                                <span class="label scout-open">&#x203A;</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="scout-section">
                    <div class="row scout-section-head">
                        <span class="stat-section-title grow">PRIVATE TAGS</span>
                        <span class="label mono">{{tags.size}} / 12</span>
                    </div>
                    <div class="scout-tags" data-if="tags.size > 0">
                        <button class="scout-tag" data-for="tag : tags" data-action="player-scout-remove-tag" data-attr-data-tag="tag" data-class-disabled="tag_saving">{{tag}}<span class="scout-tag-remove">&#xD7;</span></button>
                    </div>
                    <div class="row gap-sm" data-if="tag_can_add || tag_saving">
                        <input type="text" class="text grow scout-tag-input" data-setting="player_scout_tag" data-attr-value="tag_value" maxlength="128" placeholder="Add a tag, e.g. Strong mechanics" />
                        <button class="ghost compact" data-action="player-scout-add-tag" data-class-disabled="!tag_can_add || tag_saving">Add</button>
                    </div>
                    <div class="label" data-if="!tag_can_add && !tag_saving">Tag limit reached. Remove one to add another.</div>
                    <div class="label loss scout-tag-status" data-if="tag_status_error && tag_status != ''">{{tag_status}}</div>
                </div>
                <div class="stat-section-title">PERSONAL NOTE</div>
                <textarea class="player-note-input" data-setting="player_note_text" data-attr-value="note_value" maxlength="2000" rows="7" cols="40"></textarea>
                <div class="row player-note-meta">
                    <span class="label grow">{{updated_label}}</span>
                    <span class="label mono" data-class-loss="near_limit">{{char_count}}</span>
                </div>

                <div class="callout error" data-if="status_error">{{status}}</div>
                <div class="label win player-note-status" data-if="status != '' && !status_error">{{status}}</div>

                <div class="callout" data-if="confirm_delete">
                    <div class="row gap-sm" style="align-items:center">
                        <div class="grow">Delete this note? This can't be undone.</div>
                        <button class="danger compact" data-action="player-note-confirm-delete">Delete</button>
                        <button class="ghost compact" data-action="player-note-cancel-delete">Cancel</button>
                    </div>
                </div>
                <div class="callout" data-if="confirm_discard">
                    <div class="row gap-sm" style="align-items:center">
                        <div class="grow">Discard unsaved changes?</div>
                        <button class="danger compact" data-action="player-note-discard">Discard</button>
                        <button class="ghost compact" data-action="player-note-keep-editing">Keep editing</button>
                    </div>
                </div>

                <div class="row gap-sm player-note-actions">
                    <button class="danger compact" data-action="player-note-delete" data-if="has_saved && !confirm_delete">Delete note</button>
                    <div class="grow"></div>
                    <button class="ghost" data-action="player-note-close">Cancel</button>
                    <button class="primary" data-action="player-note-save" data-class-disabled="!dirty || saving">{{save_label}}</button>
                </div>
            </div>
        </div>
    </div>
</body>
</rml>
