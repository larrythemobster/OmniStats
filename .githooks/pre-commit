#!/usr/bin/env bash
set -euo pipefail

mapfile -d '' files < <(
    git diff --cached --name-only --diff-filter=ACMR -z -- \
        '*.c' '*.cc' '*.cpp' '*.cxx' \
        '*.h' '*.hh' '*.hpp' '*.hxx' '*.inl'
)

if (( ${#files[@]} == 0 )); then
    exit 0
fi

echo "Running clang-format on staged C/C++ files..."

status=0
for file in "${files[@]}"; do
    [[ -f "$file" ]] || continue
    # Re-adding a partially staged file would also stage the hunks left out on purpose.
    if ! git diff --quiet -- "$file"; then
        echo "pre-commit: $file has unstaged changes. Format and stage it yourself, or stash the unstaged hunks." >&2
        status=1
        continue
    fi
    clang-format -i --style=file -- "$file"
    git add -- "$file"
done
exit "$status"